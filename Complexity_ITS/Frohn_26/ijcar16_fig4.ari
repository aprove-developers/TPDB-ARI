; example from figure 4 of the IJCAR 16 paper "Lower Runtime Bounds for Integer Programs"
; obtained from fig3 via chaining
; its runtime is in Theta(n^4)

(format LCTRS)
(theory Ints)
(fun l0 (-> Int Int Int Int Int))
(fun l2 (-> Int Int Int Int Int))
(entrypoint l0)
(rule (l0 x y z u) (l2 0 (div (+ (* x x) x) 2) (div (+ (* x x) x) 2) u) :guard (> x 0) :cost (+ x 2))
(rule (l2 x y z u) (l2 x y (- z 1) 0) :guard (> z 1) :cost (+ z 1))

