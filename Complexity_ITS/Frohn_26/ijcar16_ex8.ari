; example 8 from the IJCAR 16 paper "Lower Runtime Bounds for Integer Programs"
; its runtime is linear, but to show that, a metering function with rational coefficients is needed

(format LCTRS)
(theory Ints)
(fun l0 (-> Int Int))
(fun l1 (-> Int Int))
(entrypoint l0)
(rule (l0 x) (l1 x))
(rule (l1 x) (l1 (- x 2)) :guard (> x 0))

