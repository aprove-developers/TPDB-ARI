; Off-cycle strict rule c -> d, list-encoded
(format TRS)
(fun cons 2)
(fun nil 0)
(fun A 0)
(fun L 0)
(fun a 0)
(fun R 0)
(fun B 0)
(fun c 0)
(fun d 0)
(rule (cons c x) (cons d x))
(rule (cons A (cons L x)) (cons A (cons a (cons R x))) :cost 0)
(rule (cons R (cons a x)) (cons a (cons a (cons R x))) :cost 0)
(rule (cons R (cons B x)) (cons L (cons B (cons c x))) :cost 0)
(rule (cons a (cons L x)) (cons L (cons a (cons a x))) :cost 0)
