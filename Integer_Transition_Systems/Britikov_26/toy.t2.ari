(format LCTRS)
(theory Ints)
(fun l0 (-> Int Int))
(fun l1 (-> Int Int))
(fun l4 (-> Int Int))
(fun l5 (-> Int Int))
(entrypoint l5)
(rule (l4 x^0) (l1 x^1) :guard (>= x^0 100))
(rule (l0 x^0) (l4 x^1) :guard (= x^1 (+ x^0 1)))
(rule (l4 x^0) (l0 x^1) :guard (and (< x^0 100) (= x^1 x^0)))
(rule (l5 x^0) (l4 x^1) :guard (= x^0 x^1))
