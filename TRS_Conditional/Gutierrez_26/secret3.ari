(format CTRS oriented)
(fun gr 2)
(fun le 2)
(fun minus 2)
(fun div 2)
(fun pair 2)
(fun s 1)
(fun |0| 0)
(fun true 0)
(rule (gr (s x) |0|) true)
(rule (gr (s x) (s y)) (gr x y))
(rule (le |0| x) true)
(rule (le (s x) (s y)) (le x y))
(rule (minus x |0|) x)
(rule (minus |0| y) |0|)
(rule (minus (s x) (s y)) (minus x y))
(rule (div x y) (pair |0| x) (= (gr y x) true))
(rule (div x y) (pair (s q) r) (= (le y x) true) (= (div (minus x y) y) (pair q r)))
