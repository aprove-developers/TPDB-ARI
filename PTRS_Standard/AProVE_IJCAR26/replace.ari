; Examples used for the Evaluation of AProVE in the Paper
; "Disproving (Positive) Almost-Sure Termination of
; Probabilistic Term Rewriting via Random Walks"
; Published in Proc. IJCAR'26

; An algorithm that replaces each 1 in a list of 0s and 1s
; by a sequence <0^n 1>, where n is chosen probabilistically.

(format PTRS)

(fun replace 1)
(fun cons 2)
(fun app 2)
(fun nil 0)
(fun |1| 0)
(fun |0| 0)

(prule (replace nil) ((nil :prob 1 )))
(prule (replace (cons |1| xs)) (((replace (cons |0| (cons |1| xs))) :prob 1 ) ((cons |1| (replace xs)) :prob 1 )))
(prule (replace (cons |0| xs)) (((cons |0| (replace xs)) :prob 1 )))