; Stochastic context-free grammar for RNA secondary structure (Knudsen-Hein style).
; Non-terminals S,L,F; terminals s,d combined in parallel via com_k constructors.
; Probabilities such that the system is SAST.
; Expected: WORST_CASE(?,SAST). Class: Ground, Non-overlapping, Tail-recursive.

(format PTRS)

(fun S 0) (fun L 0) (fun F 0) (fun s 0) (fun d 0) (fun com1 1) (fun com2 2) (fun com3 3)

(prule S (((com1 L) :prob 3) ((com2 L S) :prob 1)))
(prule L (((com1 s) :prob 4) ((com3 d F d) :prob 1)))
(prule F (((com3 d F d) :prob 4) ((com2 L S) :prob 2)))
