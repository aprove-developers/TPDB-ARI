; Random binary tree builder with leaf matching.
; grow(alpha)/grow(beta) either extends into a node(left, label, right) or collapses to a leaf;
; flip probabilistically picks alpha or beta as the centre label.
; Expected: WORST_CASE(Non-SAST,AST). Class: Right-Ground, Non-overlapping, (Non-tail) recursive.

(format PTRS)

(fun grow 1) (fun flip 0) (fun alpha 0) (fun beta 0)
(fun node 3) (fun match 0) (fun miss 0)

(prule (grow alpha) (((node (grow alpha) flip (grow beta)) :prob 3) (alpha :prob 1)))
(prule (grow beta) (((node (grow beta) flip (grow alpha)) :prob 3) (beta :prob 1)))
(prule flip ((alpha :prob 1) (beta :prob 1)))
(prule (node alpha x alpha) ((match :prob 1)))
(prule (node beta x beta) ((match :prob 1)))
