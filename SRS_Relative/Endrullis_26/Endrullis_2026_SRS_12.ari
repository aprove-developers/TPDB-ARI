; Simplified binary counter (6 rules)
(format TRS)
(fun H 1)
(fun E 1)
(fun o 1)
(fun i 1)
(fun c 1)
(fun r 1)
(rule (i (c x)) (c (o x)) :cost 0)
(rule (o (c x)) (i (r x)) :cost 0)
(rule (H (c x)) (H (i (r x))) :cost 0)
(rule (r (o x)) (o (r x)) :cost 0)
(rule (r (i x)) (i (r x)) :cost 0)
(rule (r (E x)) (c (E x)))
