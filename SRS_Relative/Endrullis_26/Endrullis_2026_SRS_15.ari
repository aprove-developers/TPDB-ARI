; Rule 60 elementary cellular automaton (Sierpinski / Pascal mod 2)
(format SRS)
(fun H 1)
(fun E 1)
(fun a 1)
(fun b 1)
(fun c 1)
(fun d 1)
(fun P 1)
(fun Q 1)
(fun R 1)
(rule (H (R x)) (H (P x)))
(rule (P (a x)) (c (P x)) :cost 0)
(rule (P (b x)) (d (Q x)) :cost 0)
(rule (Q (a x)) (d (P x)) :cost 0)
(rule (Q (b x)) (c (Q x)) :cost 0)
(rule (P (E x)) (c (R (E x))) :cost 0)
(rule (Q (E x)) (d (R (E x))) :cost 0)
(rule (c (R x)) (R (a x)) :cost 0)
(rule (d (R x)) (R (b x)) :cost 0)
