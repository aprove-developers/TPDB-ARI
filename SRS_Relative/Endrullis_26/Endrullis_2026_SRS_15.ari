; Rule 60 elementary cellular automaton (Sierpinski / Pascal mod 2)
(format SRS)
(fun H 1)
(fun E 1)
(fun a 1)
(fun b 1)
(fun c 1)
(fun d 1)
(fun P 1)
(fun Q 1)
(fun R 1)
(rule (H R) (H P))
(rule (P a) (c P) :cost 0)
(rule (P b) (d Q) :cost 0)
(rule (Q a) (d P) :cost 0)
(rule (Q b) (c Q) :cost 0)
(rule (P E) (c R E) :cost 0)
(rule (Q E) (d R E) :cost 0)
(rule (c R) (R a) :cost 0)
(rule (d R) (R b) :cost 0)
