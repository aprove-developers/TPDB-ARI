; Off-cycle strict rule c -> d driven by a weak marker cycle
(format TRS)
(fun c 1)
(fun d 1)
(fun A 1)
(fun L 1)
(fun a 1)
(fun R 1)
(fun B 1)
(rule (c x) (d x))
(rule (A (L x)) (A (a (R x))) :cost 0)
(rule (R (a x)) (a (a (R x))) :cost 0)
(rule (R (B x)) (L (B (c x))) :cost 0)
(rule (a (L x)) (L (a (a x))) :cost 0)
