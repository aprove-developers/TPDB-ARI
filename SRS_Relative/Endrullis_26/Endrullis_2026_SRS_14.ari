; Lindenmayer / Fibonacci L-system (A -> AB, B -> A)
(format SRS)
(fun H 1)
(fun E 1)
(fun G 1)
(fun R 1)
(fun A 1)
(fun B 1)
(fun P 1)
(fun Q 1)
(rule (H R) (H G))
(rule (G A) (P Q G) :cost 0)
(rule (G B) (P G) :cost 0)
(rule (G E) (R E) :cost 0)
(rule (Q R) (R B) :cost 0)
(rule (P R) (R A) :cost 0)
