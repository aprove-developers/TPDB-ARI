; Lindenmayer / Fibonacci L-system (A -> AB, B -> A)
(format SRS)
(fun H 1)
(fun E 1)
(fun G 1)
(fun R 1)
(fun A 1)
(fun B 1)
(fun P 1)
(fun Q 1)
(rule (H (R x)) (H (G x)))
(rule (G (A x)) (P (Q (G x))) :cost 0)
(rule (G (B x)) (P (G x)) :cost 0)
(rule (G (E x)) (R (E x)) :cost 0)
(rule (Q (R x)) (R (B x)) :cost 0)
(rule (P (R x)) (R (A x)) :cost 0)
