; Central engine M emitting on both sides (strict RML -> LaMaR)
(format SRS)
(fun R 1)
(fun M 1)
(fun L 1)
(fun a 1)
(fun A 1)
(fun C 1)
(rule (R (M (L x))) (L (a (M (a (R x))))))
(rule (A (L x)) (A (a (R x))) :cost 0)
(rule (R (A x)) (L (C x)) :cost 0)
(rule (R (a x)) (a (a (R x))) :cost 0)
(rule (a (L x)) (L (a (a x))) :cost 0)
