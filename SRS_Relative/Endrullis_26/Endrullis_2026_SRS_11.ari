; Binary counter
(format SRS)
(fun W 1)
(fun E 1)
(fun I 1)
(fun J 1)
(fun K 1)
(fun o 1)
(fun n 1)
(rule (W K) (W I))
(rule (I o) (o I) :cost 0)
(rule (I n) (n I) :cost 0)
(rule (I E) (J E) :cost 0)
(rule (n J) (J o) :cost 0)
(rule (o J) (n K) :cost 0)
(rule (W J) (W n K) :cost 0)
(rule (o K) (K o) :cost 0)
(rule (n K) (K n) :cost 0)
