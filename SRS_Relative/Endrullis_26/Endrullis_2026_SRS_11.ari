; Binary counter
(format SRS)
(fun W 1)
(fun E 1)
(fun I 1)
(fun J 1)
(fun K 1)
(fun o 1)
(fun n 1)
(rule (W (K x)) (W (I x)))
(rule (I (o x)) (o (I x)) :cost 0)
(rule (I (n x)) (n (I x)) :cost 0)
(rule (I (E x)) (J (E x)) :cost 0)
(rule (n (J x)) (J (o x)) :cost 0)
(rule (o (J x)) (n (K x)) :cost 0)
(rule (W (J x)) (W (n (K x))) :cost 0)
(rule (o (K x)) (K (o x)) :cost 0)
(rule (n (K x)) (K (n x)) :cost 0)
