; Marker cycle with auxiliary recoding (strict fed -> d)
(format SRS)
(fun f 1)
(fun e 1)
(fun d 1)
(fun A 1)
(fun L 1)
(fun c 1)
(fun a 1)
(fun R 1)
(fun B 1)
(rule (f e d) (d))
(rule (A L) (c d A a R) :cost 0)
(rule (R a) (a a R) :cost 0)
(rule (R B) (L B) :cost 0)
(rule (a L) (L a a) :cost 0)
(rule (c) (f e) :cost 0)
