; Marker cycle with auxiliary recoding (strict fed -> d)
(format TRS)
(fun f 1)
(fun e 1)
(fun d 1)
(fun A 1)
(fun L 1)
(fun c 1)
(fun a 1)
(fun R 1)
(fun B 1)
(rule (f (e (d x))) (d x))
(rule (A (L x)) (c (d (A (a (R x))))) :cost 0)
(rule (R (a x)) (a (a (R x))) :cost 0)
(rule (R (B x)) (L (B x)) :cost 0)
(rule (a (L x)) (L (a (a x))) :cost 0)
(rule (c x) (f (e x)) :cost 0)
