(format TRS)
(fun |0| 0)
(fun s 1)
(fun cons 2)
(fun mark 1)
(fun from 1)
(fun nth 2)
(fun a_from 1)
(fun a_nth 2)
(rule (mark |0|) |0|)
(rule (mark (s n)) (s (mark n)))
(rule (mark (cons x xs)) (cons x xs))
(rule (mark (from x)) (a_from (mark x)))
(rule (mark (nth n xs)) (a_nth n (mark xs)))
(rule (a_from x) (cons (mark x) (from (s x))))
(rule (a_nth |0| (cons x xs)) x)
(rule (a_nth (s n) (cons x xs)) (a_nth (mark n) (mark xs)))
