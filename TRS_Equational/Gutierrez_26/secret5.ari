(format ETRS)
(fun and 2 :theory AC)
(fun or 2 :theory AC)
(fun false 0)
(fun true 0)
(fun eq 2 :theory C)
(fun |0| 0)
(fun s 1)
(fun list 2 :theory A)
(rule (and true b) b)
(rule (and false b) false)
(rule (or true b) true)
(rule (or false b) b)
(rule (eq n n) true)
(rule (eq |0| (s n)) false)
(rule (eq (s n1) (s n2)) (eq n1 n2))
(rule (eq (list n l) nil) false)
(rule (eq (list n l1) (list m l2)) (and (eq n m) (eq l1 l2)))
